# Required: use the UPI ID that belongs to your own merchant/bank account.
MERCHANT_UPI_ID=your-business@upi
MERCHANT_NAME=Your Business Name

# Optional application settings
PORT=8080

# Admin bootstrap (change the password before deploying publicly)
ADMIN_EMAIL=admin@mrkzone.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Store Administrator

# Keep this secret stable across backend restarts/deploys.
# Generate a private Base64 key; do not commit the real value.
JWT_SECRET=replace-with-a-private-base64-secret-of-at-least-32-bytes

# Use persistent storage on the hosting platform (example Render disk mount)
UPLOAD_DIR=/var/data/uploads
